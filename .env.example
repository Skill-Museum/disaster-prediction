# Nepal Early-Warning Dashboard — optional environment overrides.
# Copy to .env if you want dotenv-style values, or just set these in the
# process environment / PaaS dashboard. All are optional.

# Port the server listens on (default 3000, or set by the host platform).
PORT=3001

# Set to '1' to disable the auto-research web-search agent.
# Useful on hosts with restricted outbound network access or low bandwidth.
DISABLE_AGENT=0

# Refresh interval for live data, in milliseconds (default 120000 = 2 min).
REFRESH_MS=120000